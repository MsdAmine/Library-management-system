# ─────────────────────────────────────────────────────────────────────────────
# Library Management System – Frontend Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env (or .env.local for local overrides) and fill in the
# values for your target environment.  Never commit real secrets to source
# control; only commit this template.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the Spring Boot REST API (no trailing slash).
# • Development  → http://localhost:8080/api/v1
# • Staging      → https://api-staging.yourdomain.com/api/v1
# • Production   → https://api.yourdomain.com/api/v1
VITE_API_BASE_URL=http://localhost:8080/api/v1
